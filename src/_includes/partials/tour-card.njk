<a class="tour-card" href="{{ tour.url }}"
   data-categories="{{ (tour.data.categories or []) | join(' ') }}"
   data-duration="{{ tour.data.duration or '' }}">
  <div class="tour-card__img"><img src="{{ tour.data.image }}" alt="{{ tour.data.image_alt }}" loading="lazy"></div>
  <div class="tour-card__body">
    <div>
      <h3>{{ tour.data.title }}</h3>
      <div class="tour-card__meta">
        {% if tour.data.duration %}<span><svg><use href="#i-calendar"/></svg>{{ tour.data.duration }} days</span>{% endif %}
        {% set fp = tour.data | fromPrice %}{% if fp %}<span class="tour-card__price">from {{ fp | money(tour.data.currency) }}</span>{% endif %}
      </div>
    </div>
    <svg class="arrow"><use href="#i-arrow"/></svg>
  </div>
</a>
