<form class="finder" id="finder" action="/tours/" method="get">
  <div class="finder__field">
    <svg class="finder__icon"><use href="#i-compass"/></svg>
    <div class="finder__control">
      <label for="f-style">Your travel style</label>
      <select id="f-style" name="style">
        <option value="">Any style</option>
        {% for o in tourOptions.styles %}<option value="{{ o.value }}">{{ o.label }}</option>{% endfor %}
      </select>
    </div>
  </div>
  <div class="finder__field">
    <svg class="finder__icon"><use href="#i-calendar"/></svg>
    <div class="finder__control">
      <label for="f-duration">How long?</label>
      <select id="f-duration" name="duration">
        <option value="">Any duration</option>
        {% for o in tourOptions.durations %}<option value="{{ o.value }}">{{ o.label }}</option>{% endfor %}
      </select>
    </div>
  </div>
  <div class="finder__field">
    <svg class="finder__icon"><use href="#i-mountain"/></svg>
    <div class="finder__control">
      <label for="f-interest">What moves you?</label>
      <select id="f-interest" name="interest">
        <option value="">Nature, culture, food…</option>
        {% for o in tourOptions.interests %}<option value="{{ o.value }}">{{ o.label }}</option>{% endfor %}
      </select>
    </div>
  </div>
  <button type="submit" class="btn btn--primary">{{ finderButton or "Explore" }} <svg class="arrow"><use href="#i-arrow"/></svg></button>
</form>
