<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title and page.url != "/" %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ summary or site.meta_description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Nothing+You+Could+Do&display=swap">
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>
{% include "partials/icons.njk" %}

<div class="topbar">
  <div class="wrap">
    <span class="topbar__tag">{{ site.topbar_tagline }}</span>
    <div class="topbar__right">
      <a href="mailto:{{ site.email }}"><svg class="arrow" style="width:15px;height:15px"><use href="#i-mail"/></svg>{{ site.email }}</a>
      {% set withYoutube = false %}{% include "partials/social.njk" %}
    </div>
  </div>
</div>

<header class="header">
  <div class="wrap">
    <a href="/" class="logo" aria-label="{{ site.name }} home">
      <img src="/img/logo-terracotta.png" alt="Locate Georgia, since 2017" width="934" height="410">
    </a>
    <nav class="nav" id="nav" aria-label="Main">
      <a href="/tours/"{% if page.url.startsWith("/tours") %} aria-current="page"{% endif %}>Our tours</a>
      <a href="/services/">Travel services</a>
      <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About us</a>
      <a href="/journal/">Journal</a>
      <a href="/contact/">Contact</a>
      <a href="/contact/#plan" class="btn btn--primary nav__cta">Plan my journey <svg class="arrow"><use href="#i-arrow"/></svg></a>
    </nav>
    <a href="/contact/#plan" class="btn btn--primary">Plan my journey <svg class="arrow"><use href="#i-arrow"/></svg></a>
    <button class="menu-toggle" id="menuToggle" aria-controls="nav" aria-expanded="false" aria-label="Open menu"><svg><use href="#i-menu"/></svg></button>
  </div>
</header>

<main>
{{ content | safe }}

  <section class="cta">
    <div class="wrap">
      <h2>{{ home.cta.title }}</h2>
      <a href="/contact/#plan" class="btn btn--ghost-light">{{ home.cta.button_label }} <svg class="arrow"><use href="#i-arrow"/></svg></a>
      <p class="cta__note">{{ home.cta.note }}</p>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <a href="/" class="logo logo--ink" aria-label="{{ site.name }} home">
        <img src="/img/logo-terracotta.png" alt="Locate Georgia, since 2017" width="934" height="410">
      </a>
      <nav class="footer__nav" aria-label="Footer">
        <a href="/tours/">Our tours</a>
        <a href="/services/">Travel services</a>
        <a href="/about/">About us</a>
        <a href="/journal/">Journal</a>
        <a href="/contact/">Contact</a>
      </nav>
      <div class="footer__social">
        {% set withYoutube = true %}{% include "partials/social.njk" %}
        <p class="footer__tag">{{ site.footer_tagline | nl2br | safe }}</p>
      </div>
    </div>
    <div class="footer__contact">
      <span>{{ site.address }}</span>
      {% if site.phone_1 %}<a href="tel:{{ site.phone_1 | digits }}">{{ site.phone_1 }}</a>{% endif %}
      {% if site.phone_2 %}<a href="tel:{{ site.phone_2 | digits }}">{{ site.phone_2 }}</a>{% endif %}
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      {% if site.whatsapp %}<a href="{{ site.whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>{% endif %}
    </div>
    <div class="footer__bottom">
      <span>© {{ "" | year }} {{ site.name }} · {{ site.legal_name }}. All rights reserved.</span>
      <div class="footer__legal">
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms &amp; Conditions</a>
      </div>
    </div>
  </div>
</footer>

<script src="/js/main.js"></script>
</body>
</html>
