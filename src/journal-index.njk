---
layout: layouts/base.njk
title: Blog
permalink: /blog/
---
{%- set b = blogPage -%}
<section class="page-hero page-hero--short" style="--hero-img: url('{{ b.hero_image }}')">
  <div class="wrap"><h1>{{ b.title }}</h1></div>
</section>

<section class="wrap blog">
  {% if b.intro %}<p class="svc__intro blog__intro">{{ b.intro }}</p>{% endif %}
  {% if collections.journal.length %}
  {%- set used = [] -%}{%- for p in collections.journal -%}{% if p.data.category and not (p.data.category in used) %}{% set used = (used.push(p.data.category), used) %}{% endif %}{%- endfor -%}
  {% if used.length > 1 %}
  <div class="chips" role="group" aria-label="Filter by topic">
    <button type="button" class="chip is-active" data-cat="">All</button>
    {% for c in b.categories %}{% if c.value in used %}<button type="button" class="chip" data-cat="{{ c.value }}">{{ c.label }}</button>{% endif %}{% endfor %}
  </div>
  {% endif %}
  <div class="post-grid" id="postGrid">
    {% for post in collections.journal %}
    {% set featured = loop.first %}{% include "partials/post-card.njk" %}
    {% endfor %}
  </div>
  {% else %}
  <p class="svc__intro">New stories are on their way.</p>
  {% endif %}
</section>
