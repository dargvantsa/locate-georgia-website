---
layout: layouts/base.njk
---
{%- set fp = { prices: prices, price: price } | fromPrice -%}
{%- macro optLabel(list, v) -%}{% for o in list %}{% if o.value == v %}{{ o.label }}{% endif %}{% endfor %}{%- endmacro -%}
<section class="tour-hero" style="--hero-img: url('{{ image }}')">
  <div class="wrap">
    <p class="eyebrow eyebrow--light"><a href="/tours/">Tours</a></p>
    <h1>{{ title }}</h1>
    <div class="tour-hero__meta">
      {% if duration %}<span><svg><use href="#i-calendar"/></svg>{{ duration }} days</span>{% endif %}
      {% if fp %}<span>from {{ fp | money(currency) }} per person</span>{% endif %}
    </div>
  </div>
</section>

<div class="wrap tour-layout">
  <article class="tour-main">
    {% if summary %}<p class="tour-main__lede">{{ summary }}</p>{% endif %}

    {% if highlights and highlights.length %}
    <section class="tour-block" aria-labelledby="hl">
      <h2 id="hl">Highlights</h2>
      <ul class="tick-list">{% for h in highlights %}<li>{{ h }}</li>{% endfor %}</ul>
    </section>
    {% endif %}

    {%- set pins = [] -%}
    {%- for v in (places or []) -%}{% for pl in tourPlaces %}{% if pl.value == v %}{% set pins = (pins.push(pl), pins) %}{% endif %}{% endfor %}{%- endfor -%}
    {% if pins.length %}
    <section class="tour-block tour-map" aria-labelledby="map-title">
      <h2 id="map-title">Where we go</h2>
      <figure class="gmap">
        <svg viewBox="0 0 {{ georgiaMap.width }} {{ georgiaMap.height }}" role="img" aria-label="Map of Georgia showing: {% for p in pins %}{{ p.label }}{% if not loop.last %}, {% endif %}{% endfor %}">
          {%- set visited = [] -%}{%- for p in pins -%}{% set visited = (visited.push(p.region), visited) %}{%- endfor -%}
          {% for r in georgiaMap.regions %}<path class="gmap__region{% if r.key in visited %} is-visited{% endif %}" d="{{ r.path }}"/>{% endfor %}
          <path class="gmap__land" d="{{ georgiaMap.path }}"/>
          <g class="gmap__labels" aria-hidden="true">
          {% for r in georgiaMap.regions %}{% if r.key != "tbilisi" %}<text x="{{ r.x }}" y="{{ r.y - (r.label.length - 1) * 9 }}" text-anchor="middle">{% for line in r.label %}<tspan x="{{ r.x }}" dy="{{ 0 if loop.first else 18 }}">{{ line }}</tspan>{% endfor %}</text>{% endif %}{% endfor %}
          </g>
          {% for p in pins %}
          {%- set x = p.lng | mapX(georgiaMap) -%}{%- set y = p.lat | mapY(georgiaMap) -%}
          <g class="gmap__pin" transform="translate({{ x }} {{ y }})">
            <path d="M0 0 C-5 -11 -17 -18 -17 -31 A17 17 0 1 1 17 -31 C17 -18 5 -11 0 0 Z"/>
            <text x="0" y="-25" text-anchor="middle">{{ loop.index }}</text>
          </g>
          {% endfor %}
        </svg>
        <figcaption>
          <ol class="gmap__list">{% for p in pins %}<li><span>{{ loop.index }}</span>{{ p.label }}</li>{% endfor %}</ol>
        </figcaption>
      </figure>
    </section>
    {% endif %}

    <section class="tour-block" aria-labelledby="it">
      <h2 id="it">Itinerary</h2>
      {% if itinerary and itinerary.length %}
      <ol class="itinerary">
        {% for d in itinerary %}
        <li class="itinerary__day">
          <details{% if loop.first %} open{% endif %}>
            <summary>
              <span class="itinerary__title">Day {{ d.day or loop.index }}: {{ d.title }}</span>
              <svg class="itinerary__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="itinerary__text">
              {% if d.text %}{% for para in d.text.split("\n\n") %}<p>{{ para | nl2br | safe }}</p>{% endfor %}{% endif %}
              {% if d.overnight %}<p>Overnight in <strong>{{ d.overnight }}</strong>.</p>{% endif %}
              {% if not d.text and not d.overnight %}<p>Details coming soon.</p>{% endif %}
            </div>
          </details>
        </li>
        {% endfor %}
      </ol>
      {% else %}
      <div class="tour-empty">
        <p>The day-by-day itinerary for this tour is being prepared.</p>
        <p>Message us and we will send you the full programme and suggest dates.</p>
      </div>
      {% endif %}
    </section>

    {%- set gal = (gallery or []).concat(page.fileSlug | folderPhotos) -%}
    {%- if not gal.length -%}{%- set gal = [{ image: image, alt: image_alt }] -%}{%- endif -%}
    {% if gal.length and gal[0].image %}
    <section class="tour-block" aria-labelledby="gal-title">
      <h2 id="gal-title">Gallery</h2>
      <div class="gallery" data-gallery>
        <div class="gallery__track" tabindex="0" aria-label="Tour photos">
          {% for g in gal %}
          <figure class="gallery__slide">
            <img src="{{ g.image }}" alt="{{ g.alt or (title + ' – photo ' + loop.index) }}" loading="lazy">
            {% if g.alt %}<figcaption>{{ g.alt }}</figcaption>{% endif %}
          </figure>
          {% endfor %}
        </div>
        {% if gal.length > 1 %}
        <button type="button" class="slider-btn slider-btn--prev gallery__btn" data-dir="-1" aria-label="Previous photo"><svg class="arrow" style="transform:scaleX(-1)"><use href="#i-arrow"/></svg></button>
        <button type="button" class="slider-btn slider-btn--next gallery__btn" data-dir="1" aria-label="Next photo"><svg class="arrow"><use href="#i-arrow"/></svg></button>
        <p class="gallery__count" aria-live="polite"><span data-current>1</span> / {{ gal.length }}</p>
        {% endif %}
      </div>
    </section>
    {% endif %}

    <section class="tour-block" aria-labelledby="prices-title">
      <h2 id="prices-title">Prices</h2>
      <div class="price-table-wrap">
        <table class="price-table">
          <thead><tr><th scope="col">Group size</th><th scope="col">Price per adult</th></tr></thead>
          <tbody>
            {% if prices and prices.length %}
            {% for r in prices %}
            <tr{% if fp and r.price == fp %} class="is-lowest"{% endif %}><th scope="row">{{ r.group }}</th><td>{% if r.price %}{{ r.price | money(currency) }}{% else %}On request{% endif %}</td></tr>
            {% endfor %}
            {% else %}
            <tr class="is-lowest"><th scope="row">Per person</th><td>{% if fp %}from {{ fp | money(currency) }}{% else %}On request{% endif %}</td></tr>
            {% endif %}
          </tbody>
        </table>
      </div>
      {%- set pnote = price_note or toursPage.price_note -%}
      {% if pnote %}<div class="price-note">{% for para in pnote.split("\n\n") %}<p>{{ para }}</p>{% endfor %}</div>{% endif %}
    </section>

    {%- set inc = included if (included and included.length) else toursPage.included -%}
    {%- set exc = not_included if (not_included and not_included.length) else toursPage.excluded -%}
    <section class="tour-block" aria-labelledby="incl-title">
      <h2 id="incl-title">What's included</h2>
      <div class="incl">
        <div class="incl__col incl__col--yes">
          <h3>Included</h3>
          <ul>{% for i in inc %}<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>{{ i }}</li>{% endfor %}</ul>
        </div>
        <div class="incl__col incl__col--no">
          <h3>Excluded</h3>
          <ul>{% for i in exc %}<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17"/></svg>{{ i }}</li>{% endfor %}</ul>
        </div>
      </div>
    </section>

  </article>

  <aside class="tour-side" aria-label="Book this tour">
    <div class="tour-side__card">
      {% if fp %}<p class="tour-side__price"><span>from</span> {{ fp | money(currency) }} <span>per person</span></p>{% endif %}
      <a href="#prices-title" class="tour-side__link">See prices{% if prices and prices.length %} by group size{% endif %}</a>
      <dl class="tour-facts">
        {% if duration %}<div><dt>Duration</dt><dd>{{ duration }} days</dd></div>{% endif %}
        {% if categories and categories.length %}<div><dt>Category</dt><dd>{% for s in categories %}{{ optLabel(tourOptions.categories, s) }}{% if not loop.last %}, {% endif %}{% endfor %}</dd></div>{% endif %}
      </dl>
      <a href="{{ site.whatsapp or '/contact/#plan' }}"{% if site.whatsapp %} target="_blank" rel="noopener"{% endif %} class="btn btn--primary tour-side__btn"><svg class="tour-side__btn-wa"><use href="#i-wa"/></svg>Ask about this tour <svg class="arrow"><use href="#i-arrow"/></svg></a>
      <a href="mailto:{{ site.email }}?subject={{ ('Question about ' + title) | urlencode }}" class="tour-side__wa"><svg><use href="#i-mail"/></svg>or email {{ site.email }}</a>
      <p class="tour-side__note">Dates, hotels and pace can be adjusted to you.</p>
    </div>
  </aside>
</div>

{%- set others = [] -%}
{%- for t in collections.tours -%}{% if t.url != page.url and others.length < 3 %}{% set others = (others.push(t), others) %}{% endif %}{%- endfor -%}
{% if others.length %}
<section class="wrap tour-more" aria-labelledby="more-title">
  <h2 id="more-title">You may also like</h2>
  <div class="tour-grid">{% for tour in others %}{% include "partials/tour-card.njk" %}{% endfor %}</div>
</section>
{% endif %}
