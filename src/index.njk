---
layout: layouts/base.njk
permalink: /
---
{%- set h = home.hero -%}
{%- set slides = h.slides if (h.slides and h.slides.length) else [{ image: h.image, location: h.location }] -%}
<section class="hero" style="--hero-img: url('{{ slides[0].image }}')" data-interval="3000">
  {% if slides.length > 1 %}
  <div class="hero__slides" aria-hidden="true">
    {% for s in slides %}
    <div class="hero__slide{% if loop.first %} is-active{% endif %}" {% if loop.first %}style="background-image: url('{{ s.image }}')"{% else %}data-bg="{{ s.image }}"{% endif %} data-location="{{ s.location }}"></div>
    {% endfor %}
  </div>
  {% endif %}
  <div class="wrap">
    <h1>{{ h.title_line_1 }}<br><em>{{ h.title_line_2 }}</em></h1>
    <p class="hero__lede">{{ h.text }}</p>
    <a href="/tours/" class="btn btn--light">{{ h.button_label }} <svg class="arrow"><use href="#i-arrow"/></svg></a>
    <span class="hero__place"{% if not slides[0].location %} hidden{% endif %}><svg><use href="#i-pin"/></svg><span class="hero__place-text">{{ slides[0].location }}</span></span>
    {% if slides.length > 1 %}
    <div class="hero__dots" role="tablist" aria-label="Photos">
      {% for s in slides %}<button type="button" class="hero__dot{% if loop.first %} is-active{% endif %}" aria-label="Show photo {{ loop.index }}"></button>{% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<div class="wrap finder-wrap">
  {% include "partials/finder.njk" %}
</div>

<div class="wrap">
  <ul class="promises">
    {%- set icons = ["i-award", "i-globe", "i-support"] -%}
    {% for p in home.promises %}
    <li><svg><use href="#{{ icons[loop.index0 % 3] }}"/></svg>{{ p.text }}</li>
    {% endfor %}
  </ul>
</div>

<section class="journeys wrap" aria-labelledby="journeys-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">{{ home.journeys.eyebrow }}</p>
      <h2 id="journeys-title">{{ home.journeys.title }}</h2>
    </div>
  </div>
  <div class="tour-carousel">
    <div class="tour-slider" data-slider="tours" tabindex="0" aria-label="Signature journeys">
      <div class="tour-track">
        {% for tour in collections.featuredTours %}{% include "partials/tour-card.njk" %}{% endfor %}
      </div>
    </div>
    <div class="slider-nav" data-slider-nav="tours" hidden>
      <button type="button" class="slider-btn slider-btn--prev" data-dir="-1" aria-label="Previous tours"><svg class="arrow" style="transform:scaleX(-1)"><use href="#i-arrow"/></svg></button>
      <button type="button" class="slider-btn slider-btn--next" data-dir="1" aria-label="Next tours"><svg class="arrow"><use href="#i-arrow"/></svg></button>
    </div>
  </div>
  <div class="slider-dots" data-slider-dots="tours" hidden></div>
  <div class="journeys__cta">
    <a href="/tours/" class="btn btn--primary">{{ home.journeys.link_label }} <svg class="arrow"><use href="#i-arrow"/></svg></a>
  </div>
</section>

{%- set w = home.welcome -%}
<section class="welcome" aria-labelledby="welcome-title">
  <div class="welcome__img"><img src="{{ w.image }}" alt="{{ w.image_alt }}" loading="lazy"></div>
  <div class="welcome__text">
    <p class="eyebrow">{{ w.eyebrow }}</p>
    <h2 id="welcome-title">{{ w.title_line_1 }}{% if w.title_line_2 %}<br>{{ w.title_line_2 }}{% endif %}</h2>
    <p>{{ w.text }}</p>
    <a href="/about/" class="link-underline">{{ w.link_label }} <svg class="arrow"><use href="#i-arrow"/></svg></a>
  </div>
  <img class="welcome__vine" src="/img/vine.png" alt="" aria-hidden="true">
  {% if w.handwritten_note %}<span class="welcome__script" aria-hidden="true">{{ w.handwritten_note | nl2br | safe }}</span>{% endif %}
</section>
